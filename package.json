{
  "name": "fx-review",
  "version": "0.4.0",
  "description": "网页版 Markdown 批注审阅工具，基于 CriticMarkup，部署于 Cloudflare Pages",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy dist",
    "build:plugin": "tsc --noEmit && cd dsh-plugin && vite build"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}